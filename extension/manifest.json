{
  "manifest_version": 3,
  "name": "Grabowski — statusy kontenerów",
  "version": "1.0.9",
  "description": "Sprawdza statusy kontenerów w Baltic Hub z przeglądarki dyspozytora i zapisuje je przy zleceniach.",
  "key": "",
  "permissions": ["storage", "alarms", "tabs", "scripting", "notifications", "debugger"],
  "host_permissions": [
    "https://baltichub.com/*",
    "https://itlgexjhznjsbonzdxyg.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Statusy kontenerów"
  },
  "icons": { "128": "icon128.png" },
  "externally_connectable": {
    "matches": [
      "https://grabowski-cargo.fleetprofit.eu/*",
      "https://master--velvety-sunflower-e15d4b.netlify.app/*"
    ]
  }
}
